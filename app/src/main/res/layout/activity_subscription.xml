<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <!-- AppBar & Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarSub"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0F766E"
            app:navigationIcon="@drawable/ic_arrow_back_m3"
            app:navigationIconTint="#FFFFFF"
            app:title="@string/paket_langganan_pro"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="720dp">

                <!-- 1. Hero Banner Card (SaaS Pro Enterprise) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#0F766E"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_nav_header_gradient"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Badge Kapsul Pro -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_version"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="@string/status_lisensi_pro_aktif"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.NetraPrint.LabelSmall"
                            android:textStyle="bold" />

                        <!-- Judul Banner -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/netraprint_enterprise_pro_aktif"
                            android:textColor="#FFFFFF"
                            android:textAppearance="@style/TextAppearance.NetraPrint.TitleLarge"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/perangkat_anda_telah_teraktivasi_lisensi_resmi_netraprint_pro_seumur_hidup_lifetime_seluruh_modul_enterprise_telah_terbuka_penuh_tanpa_batas_cetak"
                            android:textColor="#99F6E4"
                            android:textAppearance="@style/TextAppearance.NetraPrint.BodySmall" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="#26FFFFFF" />

                        <!-- Tampilan Status Lisensi Tipografi Modern -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/aktif_seumur_hidup"
                                android:textColor="#A7FFEB"
                                android:textAppearance="@style/TextAppearance.NetraPrint.TitleLarge"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginBottom="2dp"
                                android:text="@string/bebas_biaya"
                                android:textColor="#99F6E4"
                                android:textAppearance="@style/TextAppearance.NetraPrint.BodySmall" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Kartu Keunggulan Eksklusif Pro -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/fitur_keunggulan_eksklusif_pro"
                            android:textColor="#0F766E"
                            android:textAppearance="@style/TextAppearance.NetraPrint.LabelSmall"
                            android:textStyle="bold" />

                        <!-- Fitur 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@string/centang"
                                android:src="@drawable/ic_check_circle_m3" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cetak_pdf_multi_halaman_tanpa_batas"
                                    android:textColor="#263238"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodyMedium"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/cetak_10_lembar_resi_dan_invoice_pdf_sekaligus_secara_otomatis"
                                    android:textColor="#78909C"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#F0F0F0" />

                        <!-- Fitur 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@string/centang"
                                android:src="@drawable/ic_check_circle_m3" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pencetakan_jaringan_wi_fi_lan"
                                    android:textColor="#263238"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodyMedium"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/koneksi_tcp_ip_port_9100_untuk_multi_kasir_dalam_satu_jaringan"
                                    android:textColor="#78909C"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#F0F0F0" />

                        <!-- Fitur 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@string/centang"
                                android:src="@drawable/ic_check_circle_m3" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/integrasi_rest_api_webhook"
                                    android:textColor="#263238"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodyMedium"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/terima_perintah_cetak_resi_dan_struk_otomatis_dari_server_backend_pos"
                                    android:textColor="#78909C"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#F0F0F0" />

                        <!-- Fitur 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@string/centang"
                                android:src="@drawable/ic_check_circle_m3" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sinkronisasi_cloud_cadangan_konfigurasi"
                                    android:textColor="#263238"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodyMedium"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/sinkronisasi_pengaturan_dan_data_printer_antar_perangkat_hp_dan_tablet"
                                    android:textColor="#78909C"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#F0F0F0" />

                        <!-- Fitur 5 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@string/centang"
                                android:src="@drawable/ic_check_circle_m3" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/kustomisasi_header_logo_footer_toko"
                                    android:textColor="#263238"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodyMedium"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/tampilkan_branding_identitas_bisnis_anda_di_setiap_cetakan_struk"
                                    android:textColor="#78909C"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#F0F0F0" />

                        <!-- Fitur 6 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="14dp"
                                android:contentDescription="@string/centang"
                                android:src="@drawable/ic_check_circle_m3" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dukungan_prioritas_pembaruan_seumur_hidup"
                                    android:textColor="#263238"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodyMedium"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/akses_instan_ke_pembaruan_fitur_masa_depan_dan_kanal_bantuan_teknis_vip"
                                    android:textColor="#78909C"
                                    android:textAppearance="@style/TextAppearance.NetraPrint.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Tombol Status Lisensi -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpgradePro"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:backgroundTint="#0F766E"
                    android:letterSpacing="0.01"
                    android:text="@string/lisensi_pro_aktif_siap_digunakan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</LinearLayout>
