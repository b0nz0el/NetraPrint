<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    PrinterJTM Type Scale — Material 3 canonical steps (values & roles verbatim)
    ============================================================================
    LabelSmall   11sp  : chip labels, toolbar pill, dense meta info
    BodySmall    12sp  : secondary text, captions, field helper text
    BodyMedium   14sp  : default body, input text, list content
    TitleMedium  16sp  : card/file titles, emphasized sub-headings
    TitleLarge   22sp  : empty-state headlines, section headlines

    Migration rules (2.0.2):
      - Fractional sizes eliminated (10.5 -> 11, 11.5 -> 12, 13.5 -> 14).
      - Off-scale integers folded into nearest canonical step
        (13 -> 12, 15/16 -> 16, 18/20/21 -> 22, 24 -> 22).
      - Styles intentionally carry ONLY android:textSize so that per-view
        android:textColor / android:fontFamily / android:textStyle attributes
        and widget-owned text appearances (MaterialButton, Chip,
        TextInputEditText, CheckBox, ...) are never overridden.
      - Explicit android:parent on every style: no implicit-parent lookup.
    ============================================================================
-->
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Anchor style for the PrinterJTM appearance family (no attributes). -->
    <style name="TextAppearance.PrinterJTM" parent="@android:style/TextAppearance" />

    <style name="TextAppearance.PrinterJTM.LabelSmall" parent="@style/TextAppearance.PrinterJTM">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.PrinterJTM.BodySmall" parent="@style/TextAppearance.PrinterJTM">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.PrinterJTM.BodyMedium" parent="@style/TextAppearance.PrinterJTM">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.PrinterJTM.TitleMedium" parent="@style/TextAppearance.PrinterJTM">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.PrinterJTM.TitleLarge" parent="@style/TextAppearance.PrinterJTM">
        <item name="android:textSize">22sp</item>
    </style>

</resources>