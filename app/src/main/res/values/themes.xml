<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material 3 -->
    <style name="Base.Theme.NetraPrint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="fontFamily">@font/custom_font</item>
        <item name="android:windowBackground">@color/md_theme_light_background</item>
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>

        <!-- Status bar & Navigation bar styling -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Material 3 Transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.NetraPrint.Activity</item>

        <!-- Material 3 Shape & Elevation defaults -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Material3.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Material3.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Material3.Corner.Large</item>
        <item name="colorControlHighlight">#1A0F766E</item>
        <item name="bottomSheetDialogTheme">@style/Theme.NetraPrint.BottomSheetDialog</item>
    </style>

    <style name="Animation.NetraPrint.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Theme.NetraPrint" parent="Base.Theme.NetraPrint" />

    <!-- Android 12+ Modern Splash Screen Theme -->
    <style name="Theme.NetraPrint.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.NetraPrint</item>
    </style>

    <style name="TextAppearance.NetraPrint.Navigation" parent="TextAppearance.Material3.LabelLarge" tools:ignore="NewApi">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.NetraPrint.Toolbar" parent="TextAppearance.Material3.TitleLarge" tools:ignore="NewApi">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.NetraPrint.NavigationTab" parent="TextAppearance.Material3.LabelMedium" tools:ignore="NewApi">
        <item name="android:fontFamily">@font/custom_font</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.NetraPrint.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.NetraPrint.BottomSheet</item>
    </style>

    <style name="Widget.NetraPrint.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.NetraPrint.BottomSheet</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.NetraPrint.BottomSheet" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Modern M3 Form Input Style -->
    <style name="Widget.NetraPrint.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/color_state_box_stroke</item>
        <item name="hintTextColor">#0F766E</item>
    </style>

    <style name="Widget.NetraPrint.TextInputLayout.ExposedDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/color_state_box_stroke</item>
        <item name="boxBackgroundColor">#FFFFFF</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="hintTextColor">#0F766E</item>
    </style>

    <!-- Modern M3 Slider Style -->
    <style name="Widget.NetraPrint.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">#0F766E</item>
        <item name="thumbElevation">4dp</item>
        <item name="trackColorActive">#0F766E</item>
        <item name="trackColorInactive">#E2E8F0</item>
        <item name="haloColor">#330F766E</item>
        <item name="labelBehavior">floating</item>
    </style>
</resources>